# 本地开发环境变量示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# Windows (PowerShell):  $env:MAIL_PASSWORD="你的163邮箱SMTP授权码"
# Linux/macOS:           export MAIL_PASSWORD="你的163邮箱SMTP授权码"

# 163 邮箱 SMTP 授权码（必填，否则邮件发送功能不可用）
MAIL_PASSWORD=

# 数据库密码（可选，未设置时回退到 application-dev.yml 中的 1234）
DB_PASSWORD=1234

# Redis 密码（可选，未设置时回退到 application-dev.yml 中的 1234）
REDIS_PASSWORD=1234
